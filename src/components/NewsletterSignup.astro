---
import { useTranslations, type Locales } from '../i18n/utils';
import { NEWSLETTER } from '../config/site';

interface Props {
  lang: Locales;
  variant?: 'inline' | 'lead-magnet';
}

const { lang, variant = 'inline' } = Astro.props;
const t = useTranslations(lang);
---

<div class="newsletter-block" id="newsletter">
  <div class="newsletter-block__badge">
    {variant === 'lead-magnet' ? '🎁 Free Roadmap' : '📧 Newsletter'}
  </div>

  {variant === 'lead-magnet' ? (
    <>
      <h2 class="newsletter-block__title">{t('newsletter.leadMagnet')}</h2>
      <p class="newsletter-block__subtitle">{NEWSLETTER.leadMagnetDescription}</p>
    </>
  ) : (
    <>
      <h2 class="newsletter-block__title">{t('newsletter.title')}</h2>
      <p class="newsletter-block__subtitle">{t('newsletter.subtitle')}</p>
    </>
  )}

  <form
    class="newsletter-form"
    id="newsletter-form"
    data-provider={NEWSLETTER.provider}
    data-action-url={NEWSLETTER.actionUrl}
    novalidate
  >
    <label for="newsletter-email" class="sr-only">
      {t('newsletter.emailPlaceholder')}
    </label>
    <input
      type="email"
      id="newsletter-email"
      name="email"
      class="newsletter-form__input"
      placeholder={t('newsletter.emailPlaceholder')}
      required
      autocomplete="email"
      aria-required="true"
    />
    <button type="submit" class="btn btn--primary" id="newsletter-submit">
      {variant === 'lead-magnet' ? t('newsletter.leadMagnetCta') : t('newsletter.cta')}
    </button>
  </form>

  <p class="newsletter-form__privacy" aria-live="polite" id="newsletter-status">
    {t('newsletter.privacy')}
  </p>
</div>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const status = document.getElementById('newsletter-status');
  const submitBtn = document.getElementById('newsletter-submit');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (form.querySelector('#newsletter-email') as HTMLInputElement)?.value;
    if (!email) return;

    const provider = form.dataset.provider;
    const actionUrl = form.dataset.actionUrl;

    submitBtn?.setAttribute('disabled', 'true');
    if (submitBtn) submitBtn.textContent = 'Subscribing...';

    // If no provider configured, show placeholder message
    if (!provider || provider === 'none' || !actionUrl) {
      setTimeout(() => {
        if (status) {
          status.textContent = '✓ Thank you! Email provider not yet configured — check back soon.';
          status.style.color = 'var(--color-success)';
        }
        submitBtn?.removeAttribute('disabled');
        if (submitBtn) submitBtn.textContent = 'Subscribe Free';
      }, 800);
      return;
    }

    try {
      const res = await fetch(actionUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      if (res.ok) {
        if (status) {
          status.textContent = '✓ You\'re subscribed! Check your inbox.';
          status.style.color = 'var(--color-success)';
        }
        form.reset();
      } else {
        throw new Error('Network response not ok');
      }
    } catch {
      if (status) {
        status.textContent = '✗ Something went wrong. Please try again.';
        status.style.color = 'var(--color-error)';
      }
    } finally {
      submitBtn?.removeAttribute('disabled');
      if (submitBtn) submitBtn.textContent = 'Subscribe Free';
    }
  });
</script>

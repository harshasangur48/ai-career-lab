---
import { SITE, NAV_LINKS, CATEGORIES, type CategorySlug } from '../config/site';
import { useTranslations, getLocaleUrl, getLocaleName, locales, type Locales } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Locales;
  currentPath?: string;
}

const { lang, currentPath = '/' } = Astro.props;
const t = useTranslations(lang);

const navItems = [
  { key: 'nav.home', href: getLocaleUrl(lang, '/') },
  { key: 'nav.aiml', href: getLocaleUrl(lang, '/ai-ml/') },
  { key: 'nav.python', href: getLocaleUrl(lang, '/python/') },
  { key: 'nav.aitools', href: getLocaleUrl(lang, '/ai-tools/') },
  { key: 'nav.projects', href: getLocaleUrl(lang, '/projects/') },
  { key: 'nav.career', href: getLocaleUrl(lang, '/career/') },
  { key: 'nav.tutorials', href: getLocaleUrl(lang, '/tutorials/') },
] as const;

const currentFullPath = `/${lang}${currentPath}`;
---

<header class="site-header" role="banner">
  <div class="container site-header__inner">
    <!-- Logo -->
    <a href={getLocaleUrl(lang, '/')} class="site-logo" aria-label={`${SITE.name} — Home`}>
      <span class="site-logo__icon" aria-hidden="true">🤖</span>
      <span class="site-logo__text">
        AI Career <span>Lab</span>
      </span>
    </a>

    <!-- Desktop navigation -->
    <nav aria-label="Main navigation">
      <ul class="site-nav" role="list">
        {navItems.map(({ key, href }) => (
          <li>
            <a
              href={href}
              class="site-nav__link"
              aria-current={Astro.url.pathname === href || Astro.url.pathname.startsWith(href.replace(/\/$/, '') + '/') ? 'page' : undefined}
            >
              {t(key as Parameters<typeof t>[0])}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header actions -->
    <div class="header-actions">
      <!-- Language switcher -->
      <LanguageSwitcher lang={lang} currentPath={currentPath} />

      <!-- Search button -->
      <button
        id="search-btn"
        class="icon-btn"
        aria-label={t('search.openSearch')}
        title={`${t('search.openSearch')} (Ctrl+K)`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
      </button>

      <!-- Dark mode toggle -->
      <button
        id="theme-toggle"
        class="icon-btn"
        aria-label={t('theme.toggle')}
        title={t('theme.toggle')}
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
        </svg>
      </button>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="icon-btn mobile-menu-btn"
        aria-label={t('nav.openMenu')}
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile navigation menu -->
  <nav
    id="mobile-nav"
    class="mobile-nav"
    aria-label="Mobile navigation"
    aria-hidden="true"
  >
    {navItems.map(({ key, href }) => (
      <a href={href} class="mobile-nav__link">
        {t(key as Parameters<typeof t>[0])}
      </a>
    ))}
    <div style="padding: var(--space-4) 0; border-top: 1px solid var(--color-border); margin-top: var(--space-2);">
      <LanguageSwitcher lang={lang} currentPath={currentPath} mobile />
    </div>
    <a href={getLocaleUrl(lang, '/about/')} class="mobile-nav__link" style="font-size: var(--text-base); color: var(--color-text-muted);">
      {t('nav.about')}
    </a>
  </nav>
</header>

<style>
  /* Theme toggle icons */
  [data-theme="light"] .icon-sun { display: none; }
  [data-theme="light"] .icon-moon { display: block; }
  [data-theme="dark"] .icon-sun { display: block; }
  [data-theme="dark"] .icon-moon { display: none; }
  .icon-sun, .icon-moon { width: 1.1rem; height: 1.1rem; }
</style>
